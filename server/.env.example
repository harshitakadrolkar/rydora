# Server port
PORT=5000
# MongoDB connection string. If MongoDB is not reachable, RYDORA automatically
# uses its built-in local datastore (server/data/rydora-db.json) so the demo always runs.
MONGO_URI=mongodb://127.0.0.1:27017/rydora
USE_MEMORY_DB=false
JWT_SECRET=change-me-rydora-secret
CLIENT_ORIGIN=http://localhost:5173
# Simulation tuning (demo friendly)
SIM_SPEED=15
SIM_RIDE_INTERVAL_MS=12000
OFFER_TIMEOUT_SEC=15
PYTHON_BIN=python3
